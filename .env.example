# Smart Waste Robot environment configuration template
# Copy this file to .env and replace placeholder values.
# Never commit the real .env file.

API_KEY=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=8001

# Path to a locally downloaded embedding model.
# Adjust this if your model is stored elsewhere.
EMBED_MODEL=./models/all-MiniLM-L6-v2

# Keep model libraries offline; no Hugging Face download requests.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
